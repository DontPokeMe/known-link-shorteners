{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["domain", "origin", "consecutive_review_count", "first_flagged_at", "last_status", "last_checked_at"],
    "properties": {
      "domain": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
        "description": "Lowercase domain"
      },
      "origin": {
        "type": "string",
        "enum": ["shortener", "redirector", "tracking"]
      },
      "consecutive_review_count": {
        "type": "integer",
        "minimum": 1,
        "description": "Consecutive monthly runs this active domain has returned a genuine review anomaly"
      },
      "first_flagged_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO date of the first run in the current streak"
      },
      "last_status": {
        "type": "string",
        "description": "Status/error code from the most recent review-worthy probe"
      },
      "last_checked_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO date YYYY-MM-DD"
      }
    },
    "additionalProperties": false
  }
}
